SECRET_KEY=
DATABASE_PATH=
COOKIE_SECURE=

# 관세청 품목별 수출입실적(GW) 서비스키 (일반 인증키 Decoding 권장)
CUSTOMS_API_KEY=
# 품목별 국가별 서비스에서 다른 키를 쓰면 입력. 비우면 CUSTOMS_API_KEY 사용.
CUSTOMS_COUNTRY_API_KEY=

# 동일 범위로 관세청 수출 / UN Comtrade 수입 통계 조회 (중복 HS 금지)
# 기본: 3304 = 미용·메이크업·기초화장품 등. 전체 화장품 범위는 팀 HS 목록으로 변경.
COSMETICS_HS_CODES=3304
TRADE_YEARS=5
# 비우면 직전 완료 연도. 예: 2025
TRADE_END_YEAR=
# HS 2022. H5=2017, H4=2012
COMTRADE_HS_VERSION=H6
# UN Comtrade 개발자 포털 Subscription key
COMTRADE_API_KEY=

# 한국수출입은행 홈페이지에서 발급받은 OpenAPI 인증키 (공공데이터포털 서비스키와 다름)
EXCHANGE_API_KEY=
# KOTRA 해외시장뉴스 공공데이터포털 서비스키
KOTRA_API_KEY=

# 유통사 웹 검색 및 CSV 열 분류
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
